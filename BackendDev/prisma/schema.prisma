generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLAYER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED // permanent, temp bans will live in a sanctions table
  DELETED
}

enum IdentityProvider {
  EMAIL
  GOOGLE
  FACEBOOK
  APPLE
  STEAM
  GAMECENTER
  PLAYGAMES
}

enum TokenRevocationReason {
  ROTATED
  LOGOUT
  LOGOUT_ALL
  REUSE_DETECTED
  PASSWORD_CHANGED
  ADMIN
}

/// id is the Player_UUID sent to the game server
model User {
  id                   String     @id @default(uuid(7)) @db.Uuid
  displayName          String     @unique @map("display_name") @db.Citext
  avatar               String?
  role                 Role       @default(PLAYER)
  status               UserStatus @default(ACTIVE)
  /// null until the player renames for the first time (that one is free of the cooldown)
  displayNameChangedAt DateTime?  @map("display_name_changed_at") @db.Timestamptz(3)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  identities          UserIdentity[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model UserIdentity {
  id              String           @id @default(uuid(7)) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  provider        IdentityProvider
  /// for EMAIL this is the lowercased email
  providerUserId  String           @map("provider_user_id")
  email           String?          @db.Citext
  emailVerifiedAt DateTime?        @map("email_verified_at") @db.Timestamptz(3)
  passwordHash    String?          @map("password_hash")
  lastUsedAt      DateTime?        @map("last_used_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([email])
  @@map("user_identities")
}

model RefreshToken {
  id            String                 @id @default(uuid(7)) @db.Uuid
  userId        String                 @map("user_id") @db.Uuid
  tokenHash     String                 @unique @map("token_hash")
  familyId      String                 @map("family_id") @db.Uuid
  expiresAt     DateTime               @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?              @map("revoked_at") @db.Timestamptz(3)
  revokedReason TokenRevocationReason? @map("revoked_reason")
  replacedById  String?                @map("replaced_by_id") @db.Uuid
  deviceInfo    String?                @map("device_info")
  ipAddress     String?                @map("ip_address")
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// the token is the short code from the reset email, stored as an hmac
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
