# copy to .env and adjust. never commit .env

NODE_ENV=development
HOST=0.0.0.0
PORT=3333
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# true when running behind a proxy / load balancer
TRUST_PROXY=false
# comma separated, "*" allows any. not used by the unity client, only web tools
CORS_ORIGINS=http://localhost:3000
# public staging/production base URL shown in OpenAPI (optional locally)
# API_PUBLIC_URL=https://api-staging.example.com
# Swagger UI defaults to on outside production. Set explicitly on staging.
SWAGGER_ENABLED=true

# MongoDB single-node replica set (local dev only). A replica set is required
# because account creation and token rotation use transactions.
MONGO_PORT=27017
DATABASE_URL=mongodb://127.0.0.1:27017/ripptopia?replicaSet=rs0&directConnection=true

# auth
# min 32 chars. generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
JWT_ISSUER=ripptopia-api
JWT_AUDIENCE=ripptopia-client
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# the reset email sends a 6 digit code the player types in the game
PASSWORD_RESET_CODE_TTL_MINUTES=30
# requests per window per ip on the auth routes
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# email
# log = local development only; smtp = real password reset delivery
MAIL_TRANSPORT=log
MAIL_FROM=Ripptopia <no-reply@ripptopia.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# social login. a provider left empty is disabled (or mocked, see below)
# comma separated client ids the game gets google id tokens for (android, ios, desktop)
GOOGLE_CLIENT_IDS=
# both or neither
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v24.0
# comma separated, the ios bundle id (and later the services id for web)
APPLE_CLIENT_IDS=
# true = providers without real settings accept fake tokens "mock:<id>" or "mock:<id>:<email>"
# dev and staging only, never in production
SOCIAL_AUTH_MOCK=true

# profile. comma separated avatar ids the game ships with (empty = avatar_01 to avatar_08)
AVATAR_IDS=

# integration tests db, name must end with _test (it gets wiped)
DATABASE_URL_TEST=mongodb://127.0.0.1:27017/ripptopia_test?replicaSet=rs0&directConnection=true
