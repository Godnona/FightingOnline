generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED // permanent, temp bans will live in a sanctions table
  DELETED
}

enum IdentityProvider {
  EMAIL
  GOOGLE
  FACEBOOK
  APPLE
  STEAM
  GAMECENTER
  PLAYGAMES
}

enum TokenRevocationReason {
  ROTATED
  LOGOUT
  LOGOUT_ALL
  REUSE_DETECTED
  PASSWORD_CHANGED
  ADMIN
}

/// id is the Player_UUID sent to the game server
model User {
  id                    String     @id @default(uuid()) @map("_id")
  displayName           String     @map("display_name")
  /// ASCII-lowercase lookup key used to preserve case-insensitive uniqueness
  displayNameNormalized String     @unique @map("display_name_normalized")
  avatar                String?
  role                  Role       @default(PLAYER)
  status                UserStatus @default(ACTIVE)
  /// null until the player renames for the first time (that one is free of the cooldown)
  displayNameChangedAt  DateTime?  @map("display_name_changed_at")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  identities          UserIdentity[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model UserIdentity {
  id                 String           @id @default(uuid()) @map("_id")
  userId             String           @map("user_id")
  provider           IdentityProvider
  /// for EMAIL this is the lowercased email
  providerUserId     String           @map("provider_user_id")
  email              String?
  emailNormalized    String?          @map("email_normalized")
  emailVerifiedAt    DateTime?        @map("email_verified_at")
  providerGivenName  String?          @map("provider_given_name")
  providerFamilyName String?          @map("provider_family_name")
  passwordHash       String?          @map("password_hash")
  lastUsedAt         DateTime?        @map("last_used_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([emailNormalized])
  @@map("user_identities")
}

model RefreshToken {
  id            String                 @id @default(uuid()) @map("_id")
  userId        String                 @map("user_id")
  tokenHash     String                 @unique @map("token_hash")
  familyId      String                 @map("family_id")
  expiresAt     DateTime               @map("expires_at")
  revokedAt     DateTime?              @map("revoked_at")
  revokedReason TokenRevocationReason? @map("revoked_reason")
  replacedById  String?                @map("replaced_by_id")
  deviceInfo    String?                @map("device_info")
  ipAddress     String?                @map("ip_address")
  createdAt     DateTime               @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// the token is the short code from the reset email, stored as an hmac
model PasswordResetToken {
  id        String    @id @default(uuid()) @map("_id")
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
