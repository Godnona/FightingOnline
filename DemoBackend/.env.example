HOST=0.0.0.0
PORT=3334

# Use a long random value on the public host. Do not commit the real value.
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters

# Optional: comma-separated browser origins for a WebGL build. Unity desktop/mobile
# clients do not need CORS. Use * only for a public demo.
CORS_ORIGINS=*

# Optional JSON override. Passwords are plain text because this is a disposable,
# database-free demo only. Configure this as a secret environment variable on Render.
# DEMO_ACCOUNTS_JSON=[{"id":"11111111-1111-4111-8111-111111111111","email":"player1@ripptopia.demo","password":"Demo123!","displayName":"PlayerOne","role":"PLAYER"}]
